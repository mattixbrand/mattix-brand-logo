<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mattix ∞ Logo & Loading Component</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <link rel="stylesheet" href="src/styles.css" />
  </head>
  <body>
    <!-- MAIN LOGO SECTION -->
    <div class="main-logo-section">
      <div class="section-title">MATTIX Logo Animation</div>

      <div class="logo-container">
        <svg
          class="morphing-logo"
          width="280"
          height="100"
          viewBox="0 0 280 100"
        >
          <defs>
            <linearGradient
              id="snakeGradient"
              x1="0%"
              y1="0%"
              x2="100%"
              y2="0%"
            >
              <stop
                offset="0%"
                style="stop-color: #00f2fe; stop-opacity: 0.6"
              />
              <stop
                offset="30%"
                style="stop-color: #4facfe; stop-opacity: 0.9"
              />
              <stop offset="50%" style="stop-color: #ffffff; stop-opacity: 1" />
              <stop
                offset="70%"
                style="stop-color: #667eea; stop-opacity: 0.9"
              />
              <stop
                offset="100%"
                style="stop-color: #764ba2; stop-opacity: 0.6"
              />
            </linearGradient>
            <filter id="snakeGlow">
              <feGaussianBlur stdDeviation="4" result="coloredBlur" />
              <feMerge>
                <feMergeNode in="coloredBlur" />
                <feMergeNode in="SourceGraphic" />
              </feMerge>
            </filter>
          </defs>

          <!-- Single Unified Snake Path -->
          <path
            id="unifiedSnake"
            fill="none"
            stroke="url(#snakeGradient)"
            stroke-width="8"
            stroke-linecap="round"
            stroke-linejoin="round"
            filter="url(#snakeGlow)"
            stroke-dasharray="40 160"
            stroke-dashoffset="0"
            d="M45,50 C45,25 25,25 25,50 C25,75 45,75 45,50 C45,25 65,25 65,50 C65,75 45,75 45,50"
          >
            <!-- Unified Snake Path Morphing with Beautiful Rounded M -->
            <animate
              attributeName="d"
              values="M45,50 C45,25 25,25 25,50 C25,75 45,75 45,50 C45,25 65,25 65,50 C65,75 45,75 45,50;
                             M40,50 C40,30 30,30 30,50 C30,70 40,70 40,50 C40,30 50,30 50,50 C50,70 40,70 40,50;
                             M30,75 L30,40 Q30,25 35,25 Q40,20 45,25 Q50,20 55,25 Q60,25 60,40 L60,75;
                             M28,75 L28,35 Q28,20 35,20 Q42,15 45,20 Q48,15 55,20 Q62,20 62,35 L62,75;
                             M30,75 L30,40 Q30,25 35,25 Q40,20 45,25 Q50,20 55,25 Q60,25 60,40 L60,75;
                             M40,50 C40,30 30,30 30,50 C30,70 40,70 40,50 C40,30 50,30 50,50 C50,70 40,70 40,50;
                             M45,50 C45,25 25,25 25,50 C25,75 45,75 45,50 C45,25 65,25 65,50 C65,75 45,75 45,50"
              dur="12s"
              repeatCount="indefinite"
              calcMode="spline"
              keySplines="0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1;0.4 0 0.6 1"
              keyTimes="0;0.15;0.35;0.5;0.65;0.85;1"
            />

            <!-- Continuous Snake Movement -->
            <animate
              attributeName="stroke-dashoffset"
              values="0;-200;-400"
              dur="3s"
              repeatCount="indefinite"
            />

            <!-- Dynamic Glow Pulsing -->
            <animate
              attributeName="stroke-width"
              values="8;12;8"
              dur="2s"
              repeatCount="indefinite"
            />
          </path>

          <!-- ATTIX Text -->
          <text
            x="100"
            y="60"
            font-family="Arial, sans-serif"
            font-size="38"
            font-weight="900"
            letter-spacing="6"
            fill="url(#snakeGradient)"
            filter="url(#snakeGlow)"
          >
            ATTIX
          </text>
        </svg>
      </div>

      <div class="controls">
        <button class="btn primary" onclick="showStaticVersion()">
          Capture MATTIX Logo
        </button>
      </div>
    </div>

    <!-- LOADING COMPONENT SECTION -->
    <div class="loading-section">
      <div class="section-title">Loading Component</div>

      <div class="loading-container">
        <div class="loading-text">∞</div>
      </div>

      <div class="controls">
        <button class="btn" onclick="copyLoadingCode()">
          Copy Loading Code
        </button>
        <button class="btn" onclick="downloadLoadingComponent()">
          Download Component
        </button>
      </div>

      <div class="code-preview" id="codePreview" style="display: none">
        <div style="color: #00f2fe; margin-bottom: 10px">
          React Loading Component:
        </div>
        <pre style="margin: 0; white-space: pre-wrap">
const InfinityLoader = () => (
  &lt;div style={{
    fontSize: '48px',
    fontWeight: 900,
    background: 'linear-gradient(45deg, #4facfe 0%, #667eea 50%, #764ba2 100%)',
    WebkitBackgroundClip: 'text',
    backgroundClip: 'text',
    WebkitTextFillColor: 'transparent'
  }}&gt;
    ∞
  &lt;/div&gt;
);</pre
        >
      </div>
    </div>

    <!-- STATIC VERSION -->
    <div class="static-version" id="staticVersion">
      <div class="static-logo">
        <div class="section-title">Static MATTIX Logo</div>

        <div class="static-infinity-container">
          <!-- Static Logo Variations -->
          <div class="static-logo-grid">
            <div class="static-logo-item">
              <div class="static-logo-label">Brand Logo</div>
              <div class="static-mattix-text">∞ATTIX</div>
            </div>

            <div class="static-logo-item">
              <div class="static-logo-label">Alternative</div>
              <div class="static-mattix-text">MATTIX</div>
            </div>

            <div class="static-logo-item">
              <div class="static-logo-label">Loading Symbol</div>
              <div class="static-loading-text">∞</div>
            </div>
          </div>
        </div>

        <div class="controls">
          <button class="btn primary" onclick="downloadSVG()">
            Download Snake Brand Logos ZIP
          </button>
          <button class="btn" onclick="hideStaticVersion()">
            Back to Animation
          </button>
        </div>
      </div>
    </div>

    <script type="module" src="src/script.ts"></script>
  </body>
</html>
